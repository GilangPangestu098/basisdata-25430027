xPoint as="offset"/></mxGeometry></mxCell><mxCell id="l61" value="berisi" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;labelBackgroundColor=#ffffff;fontStyle=2;fontColor=#1f4e79;" vertex="1" connectable="0" parent="e58"><mxGeometry x="0" y="-10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e62" style="edgeStyle=entityRelationEdgeStyle;fontSize=11;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.3;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=12;endSize=12;" edge="1" parent="1" source="r16" target="r41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l63" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;labelBackgroundColor=#ffffff;fontStyle=1;" vertex="1" connectable="0" parent="e62"><mxGeometry x="-0.78" y="12" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="l64" value="0..N" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;labelBackgroundColor=#ffffff;fontStyle=1;" vertex="1" connectable="0" parent="e62"><mxGeometry x="0.78" y="-10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="l65" value="dibayar melalui" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;labelBackgroundColor=#ffffff;fontStyle=2;fontColor=#1f4e79;" vertex="1" connectable="0" parent="e62"><mxGeometry x="0" y="-10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e66" style="edgeStyle=entityRelationEdgeStyle;fontSize=11;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.3;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=12;endSize=12;" edge="1" parent="1" source="r46" target="r34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l67" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;labelBackgroundColor=#ffffff;fontStyle=1;" vertex="1" connectable="0" parent="e66"><mxGeometry x="-0.78" y="-10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="l68" value="0..N" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;labelBackgroundColor=#ffffff;fontStyle=1;" vertex="1" connectable="0" parent="e66"><mxGeometry x="0.78" y="-10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="l69" value="diberikan dalam" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;labelBackgroundColor=#ffffff;fontStyle=2;fontColor=#1f4e79;" vertex="1" connectable="0" parent="e66"><mxGeometry x="0" y="-10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="n70" value="Catatan kardinalitas:&lt;br&gt;• kunjungan → detail_kunjungan bernilai &lt;b&gt;0..N&lt;/b&gt; karena kunjungan dibuat petugas rekam medis (PB-03) sebelum dokter mengisi layanan (PB-04). Saat menjadi Selesai wajib 1–3 baris (AB-02, P = 1); batas ini dijaga aturan aplikasi/transaksi, bukan oleh garis ERD.&lt;br&gt;• Satu layanan hanya satu baris per kunjungan; jumlah unit dicatat di jumlah_detail_kunjungan (AB-02)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=11;strokeColor=#999999;fillColor=#fafafa;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1400" y="330" width="440" height="150" as="geometry"/></mxCell><mxCell id="n71" value="" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=11;strokeColor=#999999;fillColor=#fafafa;rounded=1;arcSize=4;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="760" height="150" as="geometry"/></mxCell><mxCell id="n72" value="&lt;b&gt;Keterangan&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="566" width="200" height="20" as="geometry"/></mxCell><mxCell id="e73" style="html=1;endArrow=ERmandOne;startArrow=none;endFill=0;endSize=12;strokeWidth=1.3;strokeColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="54" y="598" as="sourcePoint"/><mxPoint x="114" y="598" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n74" value="&lt;b&gt;1&lt;/b&gt; = tepat satu (wajib, maks. satu)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="124" y="588" width="260" height="20" as="geometry"/></mxCell><mxCell id="e75" style="html=1;endArrow=ERzeroToOne;startArrow=none;endFill=0;endSize=12;strokeWidth=1.3;strokeColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="54" y="624" as="sourcePoint"/><mxPoint x="114" y="624" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n76" value="&lt;b&gt;0..1&lt;/b&gt; = nol atau satu (opsional)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="124" y="614" width="260" height="20" as="geometry"/></mxCell><mxCell id="e77" style="html=1;endArrow=ERoneToMany;startArrow=none;endFill=0;endSize=12;strokeWidth=1.3;strokeColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="54" y="650" as="sourcePoint"/><mxPoint x="114" y="650" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n78" value="&lt;b&gt;1..N&lt;/b&gt; = satu atau banyak" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="124" y="640" width="260" height="20" as="geometry"/></mxCell><mxCell id="e79" style="html=1;endArrow=ERzeroToMany;startArrow=none;endFill=0;endSize=12;strokeWidth=1.3;strokeColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="54" y="676" as="sourcePoint"/><mxPoint x="114" y="676" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n80" value="&lt;b&gt;0..N&lt;/b&gt; = nol atau banyak" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="124" y="666" width="260" height="20" as="geometry"/></mxCell><mxCell id="n81" value="&lt;b&gt;PK&lt;/b&gt; kunci primer &amp;nbsp; &lt;b&gt;FK&lt;/b&gt; kunci tamu &amp;nbsp; &lt;b&gt;PK,FK&lt;/b&gt; kunci primer komposit yang juga kunci tamu &amp;nbsp; &lt;b&gt;UK&lt;/b&gt; kunci unik (kunci alternatif)&lt;br&gt;&lt;font color=&quot;#b3261e&quot;&gt;(P)&lt;/font&gt; data pribadi, akses dibatasi&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#808080&quot;&gt;/ atribut&lt;/font&gt;&lt;/i&gt; atribut turunan: dihitung, tidak disimpan (keputusan akhir di Modul 4)&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#1f4e79&quot;&gt;kata kerja&lt;/font&gt;&lt;/i&gt; di tengah garis = nama relasi; garis ditarik dari PK ke FK yang merujuknya&lt;br&gt;Simbol di dekat kotak = maksimum, simbol yang lebih jauh = minimum." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="370" y="590" width="420" height="114" as="geometry"/></mxCell><mxCell id="n82" value="&lt;b&gt;Catatan tinjauan klien&lt;/b&gt; (diisi setelah ERD ditinjau teman sekelas yang berperan sebagai pemilik klinik)&lt;br&gt;1. Umpan balik: … — Keputusan: diterima/ditolak — Alasan: …&lt;br&gt;2. Umpan balik: … — Keputusan: diterima/ditolak — Alasan: …&lt;br&gt;Peninjau: … (NIM …), tanggal: …" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=11;strokeColor=#999999;fillColor=#fafafa;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="820" y="560" width="1020" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>