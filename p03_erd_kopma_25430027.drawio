"1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="54" y="764" as="sourcePoint"/><mxPoint x="114" y="764" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n170" value="&lt;b&gt;0..1&lt;/b&gt; = nol atau satu (opsional)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="124" y="754" width="260" height="20" as="geometry"/></mxCell><mxCell id="e171" style="html=1;endArrow=ERoneToMany;startArrow=none;endFill=0;endSize=12;strokeWidth=1.3;strokeColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="54" y="790" as="sourcePoint"/><mxPoint x="114" y="790" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n172" value="&lt;b&gt;1..N&lt;/b&gt; = satu atau banyak" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="124" y="780" width="260" height="20" as="geometry"/></mxCell><mxCell id="e173" style="html=1;endArrow=ERzeroToMany;startArrow=none;endFill=0;endSize=12;strokeWidth=1.3;strokeColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="54" y="816" as="sourcePoint"/><mxPoint x="114" y="816" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n174" value="&lt;b&gt;0..N&lt;/b&gt; = nol atau banyak" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="124" y="806" width="260" height="20" as="geometry"/></mxCell><mxCell id="n175" value="&lt;b&gt;PK&lt;/b&gt; kunci primer &amp;nbsp; &lt;b&gt;FK&lt;/b&gt; kunci tamu &amp;nbsp; &lt;b&gt;PK,FK&lt;/b&gt; kunci primer komposit yang juga kunci tamu &amp;nbsp; &lt;b&gt;UK&lt;/b&gt; kunci unik (kunci alternatif)&lt;br&gt;&lt;font color=&quot;#b3261e&quot;&gt;(P)&lt;/font&gt; data pribadi, akses dibatasi&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#808080&quot;&gt;/ atribut&lt;/font&gt;&lt;/i&gt; atribut turunan: dihitung, tidak disimpan (keputusan akhir di Modul 4)&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#1f4e79&quot;&gt;kata kerja&lt;/font&gt;&lt;/i&gt; di tengah garis = nama relasi; garis ditarik dari PK ke FK yang merujuknya&lt;br&gt;Simbol di dekat kotak = maksimum, simbol yang lebih jauh = minimum." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="370" y="730" width="420" height="114" as="geometry"/></mxCell><mxCell id="n176" value="&lt;b&gt;Catatan tinjauan klien&lt;/b&gt; — peninjau: Arya Yoga Pratama (25430016), berperan sebagai ketua Kopma; tanggal: 13 Oktober 2026&lt;br&gt;1. Umpan balik: &quot;Menurut saya, entitas Detail Penjualan sudah tepat dipisahkan dari Penjualan karena satu nota bisa berisi beberapa barang, sedangkan jumlah dan harga satuan dicatat untuk setiap barang.&quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Keputusan: diterima. Alasan: sesuai rancangan; detail_penjualan memecah relasi banyak-ke-banyak dan menyimpan harga saat transaksi (AB-04). Perubahan: tidak ada.&lt;br&gt;2. Umpan balik: &quot;Menurut saya, relasi Anggota dengan Penjualan harus memungkinkan transaksi tanpa anggota karena pembeli umum juga dapat berbelanja di Kopma.&quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Keputusan: diterima. Alasan: sesuai rancangan; sisi anggota bernilai 0..1 dan id_anggota boleh kosong untuk pembeli umum (AB-02). Perubahan: tidak ada." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=11;strokeColor=#999999;fillColor=#fafafa;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="820" y="700" width="680" height="210" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d308" name="Latihan E.1 Poin"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n177" value="&lt;b&gt;Latihan E.1 — ERD Kopma dengan poin loyalitas&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;Atribut bercetak hijau ditambahkan dari Latihan E.1 Pertemuan 2 (AB-07 s.d. AB-13)&lt;/font&gt;" style="text;html=1;fontSize=16;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="44" as="geometry"/></mxCell><mxCell id="t178" value="petugas" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#555555;fontSize=13;fontColor=#1a1a1a;align=center;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="162" height="116" as="geometry"/></mxCell><mxCell id="r179" value="PK    id_petugas" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Courier New;fontSize=11;fontStyle=1;" vertex="1" parent="t178"><mxGeometry y="28" width="162" height="22" as="geometry"/></mxCell><mxCell id="r180" value="UK    kode_petugas" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Courier New;fontSize=11;" vertex="1" parent="t178"><mxGeometry y="50" width="162" height="22" as="geometry"/></mxCell><mxCell id="r181" value="      nama_petugas" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Courier New;fontSize=11;" vertex="1" parent="t178"><mxGeometry y="72" width="162" height="22" as="geometry"/></mxCell><mxCell id="r182" value="      peran_petugas" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];p