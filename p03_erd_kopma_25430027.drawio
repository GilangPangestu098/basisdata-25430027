"0" parent="e291"><mxGeometry x="0" y="-10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="n295" value="&lt;b&gt;Data yang hilang:&lt;/b&gt; qty_detail_penjualan dan harga_satuan_detail_penjualan tidak punya tempat. Qty bukan milik penjualan (satu nota banyak barang) dan bukan milik barang (satu barang di banyak nota); keduanya milik pasangan (nota, barang). Akibatnya jumlah barang per nota dan harga saat transaksi (AB-04) hilang, sehingga omzet KI-01 dan barang terlaris KI-02 tidak dapat dihitung. Selain itu relasi M:N tidak dapat disimpan langsung di tabel relasional." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=11;strokeColor=#999999;fillColor=#fafafa;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="700" height="120" as="geometry"/></mxCell><mxCell id="n296" value="" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=11;strokeColor=#999999;fillColor=#fafafa;rounded=1;arcSize=4;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="760" height="150" as="geometry"/></mxCell><mxCell id="n297" value="&lt;b&gt;Keterangan&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="446" width="200" height="20" as="geometry"/></mxCell><mxCell id="e298" style="html=1;endArrow=ERmandOne;startArrow=none;endFill=0;endSize=12;strokeWidth=1.3;strokeColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="54" y="478" as="sourcePoint"/><mxPoint x="114" y="478" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n299" value="&lt;b&gt;1&lt;/b&gt; = tepat satu (wajib, maks. satu)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="124" y="468" width="260" height="20" as="geometry"/></mxCell><mxCell id="e300" style="html=1;endArrow=ERzeroToOne;startArrow=none;endFill=0;endSize=12;strokeWidth=1.3;strokeColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="54" y="504" as="sourcePoint"/><mxPoint x="114" y="504" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n301" value="&lt;b&gt;0..1&lt;/b&gt; = nol atau satu (opsional)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="124" y="494" width="260" height="20" as="geometry"/></mxCell><mxCell id="e302" style="html=1;endArrow=ERoneToMany;startArrow=none;endFill=0;endSize=12;strokeWidth=1.3;strokeColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="54" y="530" as="sourcePoint"/><mxPoint x="114" y="530" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n303" value="&lt;b&gt;1..N&lt;/b&gt; = satu atau banyak" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="124" y="520" width="260" height="20" as="geometry"/></mxCell><mxCell id="e304" style="html=1;endArrow=ERzeroToMany;startArrow=none;endFill=0;endSize=12;strokeWidth=1.3;strokeColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="54" y="556" as="sourcePoint"/><mxPoint x="114" y="556" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n305" value="&lt;b&gt;0..N&lt;/b&gt; = nol atau banyak" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="124" y="546" width="260" height="20" as="geometry"/></mxCell><mxCell id="n306" value="&lt;b&gt;PK&lt;/b&gt; kunci primer &amp;nbsp; &lt;b&gt;FK&lt;/b&gt; kunci tamu &amp;nbsp; &lt;b&gt;PK,FK&lt;/b&gt; kunci primer komposit yang juga kunci tamu &amp;nbsp; &lt;b&gt;UK&lt;/b&gt; kunci unik (kunci alternatif)&lt;br&gt;&lt;font color=&quot;#b3261e&quot;&gt;(P)&lt;/font&gt; data pribadi, akses dibatasi&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#808080&quot;&gt;/ atribut&lt;/font&gt;&lt;/i&gt; atribut turunan: dihitung, tidak disimpan (keputusan akhir di Modul 4)&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#1f4e79&quot;&gt;kata kerja&lt;/font&gt;&lt;/i&gt; di tengah garis = nama relasi; garis ditarik dari PK ke FK yang merujuknya&lt;br&gt;Simbol di dekat kotak = maksimum, simbol yang lebih jauh = minimum." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="370" y="470" width="420" height="114" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>