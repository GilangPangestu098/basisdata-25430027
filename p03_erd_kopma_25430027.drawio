;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=12;endSize=12;" edge="1" parent="1" source="r228" target="r218"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l256" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;labelBackgroundColor=#ffffff;fontStyle=1;" vertex="1" connectable="0" parent="e255"><mxGeometry x="-0.78" y="-10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="l257" value="0..N" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;labelBackgroundColor=#ffffff;fontStyle=1;" vertex="1" connectable="0" parent="e255"><mxGeometry x="0.78" y="-10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="l258" value="tercantum di" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;labelBackgroundColor=#ffffff;fontStyle=2;fontColor=#1f4e79;" vertex="1" connectable="0" parent="e255"><mxGeometry x="0" y="-10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e259" style="edgeStyle=entityRelationEdgeStyle;fontSize=11;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.3;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=12;endSize=12;" edge="1" parent="1" source="r228" target="r224"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l260" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;labelBackgroundColor=#ffffff;fontStyle=1;" vertex="1" connectable="0" parent="e259"><mxGeometry x="-0.78" y="12" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="l261" value="0..N" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;labelBackgroundColor=#ffffff;fontStyle=1;" vertex="1" connectable="0" parent="e259"><mxGeometry x="0.78" y="-10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="l262" value="dipesan dalam" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;labelBackgroundColor=#ffffff;fontStyle=2;fontColor=#1f4e79;" vertex="1" connectable="0" parent="e259"><mxGeometry x="0" y="-10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="n263" value="&lt;b&gt;Keputusan:&lt;/b&gt; poin cukup menjadi atribut, tanpa entitas riwayat_poin.&lt;br&gt;• saldo_poin_anggota di anggota (dibaca setiap transaksi).&lt;br&gt;• Setiap perolehan/penukaran poin selalu terjadi pada satu nota, sehingga riwayat poin sudah tercatat di penjualan (poin_diperoleh, poin_digunakan, potongan_poin).&lt;br&gt;• Entitas riwayat_poin baru diperlukan jika poin dapat berubah di luar penjualan (mis. bonus, kedaluwarsa)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=11;strokeColor=#999999;fillColor=#fafafa;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1180" y="500" width="420" height="170" as="geometry"/></mxCell><mxCell id="n264" value="" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=11;strokeColor=#999999;fillColor=#fafafa;rounded=1;arcSize=4;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="760" height="150" as="geometry"/></mxCell><mxCell id="n265" value="&lt;b&gt;Keterangan&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="766" width="200" height="20" as="geometry"/></mxCell><mxCell id="e266" style="html=1;endArrow=ERmandOne;startArrow=none;endFill=0;endSize=12;strokeWidth=1.3;strokeColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="54" y="798" as="sourcePoint"/><mxPoint x="114" y="798" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n267" value="&lt;b&gt;1&lt;/b&gt; = tepat satu (wajib, maks. satu)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="124" y="788" width="260" height="20" as="geometry"/></mxCell><mxCell id="e268" style="html=1;endArrow=ERzeroToOne;startArrow=none;endFill=0;endSize=12;strokeWidth=1.3;strokeColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="54" y="824" as="sourcePoint"/><mxPoint x="114" y="824" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n269" value="&lt;b&gt;0..1&lt;/b&gt; = nol atau satu (opsional)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="124" y="814" width="260" height="20" as="geometry"/></mxCell><mxCell id="e270" style="html=1;endArrow=ERoneToMany;startArrow=none;endFill=0;endSize=12;strokeWidth=1.3;strokeColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="54" y="850" as="sourcePoint"/><mxPoint x="114" y="850" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n271" value="&lt;b&gt;1..N&lt;/b&gt; = satu atau banyak" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="124" y="840" width="260" height="20" as="geometry"/></mxCell><mxCell id="e272" style="html=1;endArrow=ERzeroToMany;startArrow=none;endFill=0;endSize=12;strokeWidth=1.3;strokeColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="54" y="876" as="sourcePoint"/><mxPoint x="114" y="876" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n273" value="&lt;b&gt;0..N&lt;/b&gt; = nol atau banyak" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="124" y="866" width="260" height="20" as="geometry"/></mxCell><mxCell id="n274" value="&lt;b&gt;PK&lt;/b&gt; kunci primer &amp;nbsp; &lt;b&gt;FK&lt;/b&gt; kunci tamu &amp;nbsp; &lt;b&gt;PK,FK&lt;/b&gt; kunci primer komposit yang juga kunci tamu &amp;nbsp; &lt;b&gt;UK&lt;/b&gt; kunci unik (kunci alternatif)&lt;br&gt;&lt;font color=&quot;#b3261e&quot;&gt;(P)&lt;/font&gt; data pribadi, akses dibatasi&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#808080&quot;&gt;/ atribut&lt;/font&gt;&lt;/i&gt; atribut turunan: dihitung, tidak disimpan (keputusan akhir di Modul 4)&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#1f4e79&quot;&gt;kata kerja&lt;/font&gt;&lt;/i&gt; di tengah garis = nama relasi; garis ditarik dari PK ke FK yang merujuknya&lt;br&gt;Simbol di dekat kotak = maksimum, simbol yang lebih jauh = minimum." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="370" y="790" width="420" height="114" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d309" name="Latihan E.2 M-N"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n275" value="&lt;b&gt;Latihan E.2 — Penjualan dan barang sebagai banyak-ke-banyak langsung&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;Tanpa entitas asosiatif detail_penjualan&lt;/font&gt;" style="text;html=1;fontSize=16;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="44" as="geometry"/></mxCell><mxCell id="t276" value="penjualan" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#f8cecc;swimlaneFillColor=#ffffff;strokeColor=#555555;fontSize=13;fontColor=#1a1a1a;align=center;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="191" height="160" as="geometry"/></mxCell><mxCell id="r277" value="PK    id_penjualan" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fo